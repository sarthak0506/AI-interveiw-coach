DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/interview_coach
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Gemini API key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Groq is used as the LLM fallback if Gemini fails, and for speech-to-text fallback
FALLBACK_API_KEY=
FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
WHISPER_ENDPOINT=http://127.0.0.1:8002
SEAMLESS_ENDPOINT=http://127.0.0.1:8003
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_TARGET_LANGUAGE=en-IN
SUPERTONIC_ENDPOINT=http://127.0.0.1:7788
SUPERTONIC_VOICE=F3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
DAILY_API_KEY=
